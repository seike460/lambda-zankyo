{
  "name": "lambda-zankyo-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r run typecheck && tsc -p scripts",
    "test": "pnpm -r run test && node --test scripts/*.test.mts",
    "build": "pnpm -r --if-present run build",
    "check:versions": "node scripts/check-versions.mts",
    "gate": "pnpm lint && pnpm check:versions && pnpm build && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-6cpc-mj5c-m9rq"
      ]
    }
  }
}
