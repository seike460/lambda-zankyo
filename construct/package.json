{
  "name": "zankyo-cdk",
  "version": "0.1.1",
  "description": "CDK construct that wires the zankyo Lambda layer, records bucket, and IAM to a function",
  "type": "module",
  "license": "MIT",
  "author": "seike460",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seike460/lambda-zankyo.git",
    "directory": "construct"
  },
  "homepage": "https://github.com/seike460/lambda-zankyo#readme",
  "bugs": {
    "url": "https://github.com/seike460/lambda-zankyo/issues"
  },
  "keywords": [
    "aws",
    "lambda",
    "serverless",
    "cdk",
    "aws-cdk",
    "construct",
    "lambda-layer"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
